# SURPLUS-TO-SHELTER PLATFORM CONFIGURATION
PORT=5000
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- MAPS & GEOLOCATION (Optional: Platform defaults to free OpenStreetMap + Leaflet) ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# --- ONLINE PAYMENTS & MONETARY DONATIONS ---
# If left blank, the platform automatically runs on the built-in escrow simulation.
# To connect live Razorpay (UPI, Netbanking, Cards):
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Or to connect live Stripe:
STRIPE_SECRET_KEY=your-stripe-secret-key

